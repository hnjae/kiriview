root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
tab_width = 8

[*.{rml,cpp,h,frag,vert}]
indent_size = 4
indent_style = space

[*.{yaml,toml,json,jsonc,clang-tidy}]
indent_size = 2
indent_style = space

[*.{md}]
indent_size = 4
indent_style = space

[{justfile,.justfile}]
indent_size = 4
indent_style = space

[*.nix]
indent_size = 2
indent_style = space
